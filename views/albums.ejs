<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>相簿 / Albums</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- PhotoSwipe CSS -->
    <link rel="stylesheet" href="/css/photoswipe/photoswipe.css">
    <style>
        body {
            font-family: 'Roboto', sans-serif;
        }
        .gallery-item {
            cursor: pointer;
            transition: transform 0.2s;
        }
        .gallery-item:hover {
            transform: scale(1.02);
        }
        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        /* 橫向圖片 */
        .landscape {
            aspect-ratio: 16 / 9;
        }
        /* 直向圖片 */
        .portrait {
            aspect-ratio: 9 / 16;
        }
        /* 正方形圖片 */
        .square {
            aspect-ratio: 1 / 1;
        }
    </style>
</head>
<body class="bg-gray-50">
<div class="min-h-screen bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 py-8">
        <!-- Banner -->
        <div class="mb-8 rounded-t-lg overflow-hidden">
            <img src="/images/banner.jpg" alt="Banner" class="w-full h-auto">
        </div>

        <!-- Title -->
        <div class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-gray-800 mb-2">相簿 / Albums</h1>
        </div>

        <!-- Gallery -->
        <div id="gallery" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            <% albums.forEach((album, index) => { %>
                <div class="gallery-item <%= album.orientation %> rounded-lg overflow-hidden shadow-md" 
                     data-pswp-src="<%= album.path %>"
                     data-pswp-width="<%= album.width || 1920 %>"
                     data-pswp-height="<%= album.height || 1080 %>"
                     data-index="<%= index %>">
                    <img src="<%= album.path %>" 
                         alt="<%= album.originalName %>" 
                         loading="lazy"
                         class="w-full h-full object-cover">
                </div>
            <% }); %>
        </div>

        <% if (albums.length === 0) { %>
            <div class="text-center py-12">
                <p class="text-gray-600 text-lg">暫無圖片 / No images yet</p>
            </div>
        <% } %>
    </div>
</div>

<!-- PhotoSwipe -->
<script src="/js/photoswipe/photoswipe.umd.min.js"></script>
<script>
(function() {
    // 等待 PhotoSwipe 加載
    function initGallery() {
        // PhotoSwipe 5.x UMD 版本會將 PhotoSwipe 類導出到 window.PhotoSwipe
        if (typeof window.PhotoSwipe === 'undefined') {
            console.error('PhotoSwipe 未正確加載');
            return;
        }
        
        const PhotoSwipe = window.PhotoSwipe;
        const galleryItems = document.querySelectorAll('.gallery-item');
        
        if (galleryItems.length === 0) return;
        
        // 準備所有圖片數據
        const items = Array.from(galleryItems).map((el) => ({
            src: el.dataset.pswpSrc,
            width: parseInt(el.dataset.pswpWidth) || 1920,
            height: parseInt(el.dataset.pswpHeight) || 1080
        }));
        
        // 為每個圖片添加點擊事件
        galleryItems.forEach((item, index) => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                
                const options = {
                    dataSource: items,
                    index: index,
                    showHideAnimationType: 'zoom',
                    bgOpacity: 0.9,
                    spacing: 0.1,
                    allowPanToNext: true,
                    loop: true,
                    pinchToClose: true,
                    closeOnVerticalDrag: true,
                    imageClickAction: 'toggle-controls',
                    tapAction: 'toggle-controls',
                    doubleTapAction: 'zoom'
                };
                
                const gallery = new PhotoSwipe(options);
                gallery.init();
            });
        });
    }
    
    // 等待 DOM 和腳本都加載完成
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            // 等待 PhotoSwipe 腳本加載完成
            setTimeout(initGallery, 50);
        });
    } else {
        setTimeout(initGallery, 50);
    }
})();
</script>
</body>
</html>
